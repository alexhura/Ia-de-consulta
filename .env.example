# Groq API (Principal) - OBTENER EN: https://console.groq.com
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=openai/gpt-oss-20b

# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (PostgreSQL) - OBTENER EN: https://supabase.com
# Dashboard > Project Settings > API > Project URL y API keys
SUPABASE_URL=https://TU_PROJECT.supabase.co
# Para backend usa la SERVICE_ROLE key (acceso total). Nunca la expongas en el frontend.
SUPABASE_API_KEY=pon_aqui_tu_api_key
# (Opcional) Ejecuta scripts/schema.sql en SQL Editor la primera vez.

# JWT Secret - CÁMBIALO en producción
JWT_SECRET=cambia-este-secreto-en-produccion